@inherits BaseComponent

<div class="@Class" style="@Style">

    <p class="h3 my-auto p-2"> @Title ></p>

    <div class="itemContainer hideScrollbar">
        @foreach (var item in Items)
        {
            <button class="p-2 flex-column d-inline" @onclick="() => NavigateToList(item.Id)">
                <img class="item" src="@item.CoverPicturePath" style="border-color: var(--secondary); border-style:solid; border-width: 2px;" alt="@item.CoverPictureAltText"/>
                <div class="title">
                    <div class="pr-2">@item.Name</div> 
                    <div>@item.Price€</div>
                </div>
            </button>
        }
    </div>
</div>